# Contact Form Gmail OAuth2 SMTP Configuration
# Copy this file to .env and configure the fields below for real email dispatching.

# Sender Gmail address
SMTP_USER=your-email@gmail.com

# Recipient email address (who receives the portfolio messages).
# If left blank, it will default to SMTP_USER.
CONTACT_EMAIL_RECEIVER=receiver-email@example.com

# Google OAuth2 Credentials for Nodemailer
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-google-oauth-refresh-token
